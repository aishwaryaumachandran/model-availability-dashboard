{
  "_comment": "Azure AI Services Model Capacity Configuration Template",
  "_instructions": [
    "1. Copy this file to 'config.json'",
    "2. Replace placeholder values with your actual Azure subscription details",
    "3. Update model versions as needed (check Azure documentation for latest versions)",
    "4. Ensure you have appropriate permissions to query Azure AI Services capacity",
    "5. IMPORTANT: Each model must have model_format, model_name, and model_version fields"
  ],
  
  "azure": {
    "subscription_id": "YOUR_SUBSCRIPTION_ID_HERE",
    "subscription_name": "YOUR_SUBSCRIPTION_NAME_HERE",
    "api_version": "2024-04-01-preview",
    "base_url": "https://management.azure.com"
  },
  
  "models": {
    "gpt-4o": {
      "model_format": "OpenAI",
      "model_name": "gpt-4o",
      "model_version": "2024-05-13"
    },
    "gpt-4": {
      "model_format": "OpenAI",
      "model_name": "gpt-4",
      "model_version": "2024-02-15-preview"
    },
    "gpt-4-32k": {
      "model_format": "OpenAI",
      "model_name": "gpt-4-32k",
      "model_version": "2024-02-15-preview"
    },
    "gpt-35-turbo": {
      "model_format": "OpenAI",
      "model_name": "gpt-35-turbo",
      "model_version": "2024-02-15-preview"
    },
    "gpt-35-turbo-16k": {
      "model_format": "OpenAI",
      "model_name": "gpt-35-turbo-16k",
      "model_version": "2024-02-15-preview"
    },
    "o1-preview": {
      "model_format": "OpenAI",
      "model_name": "o1-preview",
      "model_version": "2024-09-12"
    },
    "o1-mini": {
      "model_format": "OpenAI",
      "model_name": "o1-mini",
      "model_version": "2024-09-12"
    },
    "o3-mini": {
      "model_format": "OpenAI",
      "model_name": "o3-mini",
      "model_version": "2025-01-31"
    },
    "o4-mini": {
      "model_format": "OpenAI",
      "model_name": "o4-mini",
      "model_version": "2025-04-16"
    },
    "text-embedding-ada-002": {
      "model_format": "OpenAI",
      "model_name": "text-embedding-ada-002",
      "model_version": "2"
    },
    "text-embedding-3-small": {
      "model_format": "OpenAI",
      "model_name": "text-embedding-3-small",
      "model_version": "1"
    },
    "text-embedding-3-large": {
      "model_format": "OpenAI",
      "model_name": "text-embedding-3-large",
      "model_version": "1"
    },
    "dall-e-3": {
      "model_format": "OpenAI",
      "model_name": "dall-e-3",
      "model_version": "3.0"
    },
    "whisper": {
      "model_format": "OpenAI",
      "model_name": "whisper",
      "model_version": "2023-09-01-preview"
    },
    "tts": {
      "model_format": "OpenAI",
      "model_name": "tts",
      "model_version": "2024-02-15-preview"
    }
  },

  "request_settings": {
    "timeout": 30,
    "retry_attempts": 3,
    "retry_delay": 1
  },

  "dashboard_settings": {
    "default_sku_filter": "GlobalStandard",
    "cache_timeout_minutes": 5,
    "max_regions_display": 50,
    "enable_debug_logging": false
  },

  "authentication": {
    "_note": "Uses Azure DefaultAzureCredential - ensure you are logged in via 'az login'",
    "method": "DefaultAzureCredential",
    "tenant_id": "OPTIONAL_TENANT_ID_IF_NEEDED"
  },

  "email": {
    "_note": "Azure Communication Service email configuration",
    "connection_string": "YOUR_AZURE_COMMUNICATION_SERVICE_CONNECTION_STRING",
    "sender_email": "your-sender@your-domain.com",
    "default_recipients": [
      "recipient1@company.com",
      "recipient2@company.com"
    ],
    "subject_prefix": "[Azure Model Capacity]"
  }
}